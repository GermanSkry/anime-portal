# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/anime_db

# Claude API (for direct use)
CLAUDE_API_KEY=sk-ant-

# OpenRouter API (for Claude via OpenRouter)
OPENROUTER_API_KEY=sk-or-

# Server
PORT=8000
ENVIRONMENT=development

# Sentry performance traces: 0.1 keeps a free quota comfortable
SENTRY_TRACES_SAMPLE_RATE=0.1

# optional: overrides POSTHOG_REGION, for self-hosted PostHog or local testing
POSTHOG_HOST=
