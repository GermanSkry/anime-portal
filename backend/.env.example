# Copy to .env. Only DATABASE_URL and OPENROUTER_API_KEY are needed to run;
# everything else has a working default or disables a feature when left blank.

# --- required ---
DATABASE_URL=postgres://postgres:password@localhost:5432/anime_db

# Claude through OpenRouter. Without it the chat endpoint fails; everything
# else — browse, both searches — works.
OPENROUTER_API_KEY=
MODEL_NAME=openrouter/anthropic/claude-haiku-5.5

# --- server ---
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development          # anything but "production" locally, or local
                                 # runs report into the live Sentry and PostHog

# --- optional services ---

# Kafka/Redpanda. Chat still persists without it: the API falls back to writing
# to Postgres directly when the publish fails.
KAFKA_BROKERS=localhost:9092

# SerpAPI, 250 free searches a month. Blank means web search returns canned
# results, which the web_search PostHog event reports as source="mock_no_key".
SERPAPI_KEY=

# Sentry. Blank disables it.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1    # 1.0 samples every request and eats a free quota

# PostHog. Blank disables it.
POSTHOG_API_KEY=
POSTHOG_REGION=eu                # "eu" or "us"
POSTHOG_HOST=                    # overrides REGION, for self-hosted or a local sink

# Langfuse LLM tracing. Blank disables it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- scripts/fetch_anime_enhanced.py ---
ANILIST_PAGES=50                 # 50 per page, so 50 pages is 2,500 titles
ANILIST_DELAY=2.5                # seconds between pages; AniList allows 30/min
ANILIST_FORCE=                   # "1" lets a fetch overwrite data/anime.json with fewer titles
