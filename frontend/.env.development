VITE_API_URL=http://localhost:8000
VITE_GO_SEARCH_URL=http://localhost:8080

# Analytics. Both are public keys: they ship inside the JS bundle either way,
# so anyone who loads the site can read them. The real access control is
# PostHog's authorized URLs and Sentry's allowed domains, not secrecy.
# Left empty so a local run never feeds the real numbers. Paste the values from
# .env.production temporarily if you want to check the wiring; events are then
# tagged environment=development so they can be filtered out.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SENTRY_DSN=
# test only: lets a headless browser past PostHog's bot filter
VITE_POSTHOG_ALLOW_BOTS=
