VITE_API_URL=http://localhost:8000
VITE_GO_SEARCH_URL=http://localhost:8080

# Analytics. Both are public keys that ship in the bundle; empty means the SDK
# never starts, so a clone works with no setup.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SENTRY_DSN=
# test only: lets a headless browser past PostHog's bot filter
VITE_POSTHOG_ALLOW_BOTS=
